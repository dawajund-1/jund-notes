<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="12dp" android:paddingBottom="10dp" android:background="@drawable/widget_bg_clear">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_prayer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Mustatar" android:textColor="#FFFFFFFF" android:textSize="17sp" android:fontFamily="sans-serif-light" android:maxLines="1"
            android:shadowColor="#66000000" android:shadowRadius="3" android:shadowDy="1" />
        <TextView android:id="@+id/w_prayer_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1"
            android:shadowColor="#66000000" android:shadowRadius="3" android:shadowDy="1" />
    </LinearLayout>
    <ImageView android:id="@+id/w_day" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:scaleType="fitCenter" android:contentDescription="Today" />
</LinearLayout>
