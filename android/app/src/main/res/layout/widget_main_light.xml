<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="14dp" android:paddingBottom="14dp" android:background="@drawable/widget_bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_prayer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Mustatar" android:textColor="#FF111113" android:textSize="20sp" android:fontFamily="sans-serif-light" android:maxLines="1"  />
        <TextView android:id="@+id/w_prayer_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FF6B6B73" android:textSize="13sp" android:fontFamily="sans-serif" android:maxLines="1"  />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:layout_marginBottom="8dp">
        <TextView android:id="@+id/w_p1" style="@style/WPray" android:textColor="#FF111113"  />
        <TextView android:id="@+id/w_p2" style="@style/WPray" android:textColor="#FF111113"  />
        <TextView android:id="@+id/w_p3" style="@style/WPray" android:textColor="#FF111113"  />
        <TextView android:id="@+id/w_p4" style="@style/WPray" android:textColor="#FF111113"  />
        <TextView android:id="@+id/w_p5" style="@style/WPray" android:textColor="#FF111113"  />
    </LinearLayout>
    <TextView android:id="@+id/w_item1" style="@style/WItem" android:textColor="#FF111113"  />
    <TextView android:id="@+id/w_item2" style="@style/WItem" android:textColor="#FF111113"  />
    <TextView android:id="@+id/w_item3" style="@style/WItem" android:textColor="#FF111113"  />
</LinearLayout>
