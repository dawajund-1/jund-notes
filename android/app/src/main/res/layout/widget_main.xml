<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_prayer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Mustatar" android:textColor="#5FD6C1" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/w_prayer_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#93A3C0" android:textSize="12sp" android:maxLines="1" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/w_item1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E8EDF6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp" />
    <TextView android:id="@+id/w_item2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E8EDF6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp" />
    <TextView android:id="@+id/w_item3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E8EDF6" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp" />
</LinearLayout>
