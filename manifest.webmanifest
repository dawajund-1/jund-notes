{
  "name": "Daftar — notes, tasks and calendar",
  "short_name": "Daftar",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0A1222",
  "theme_color": "#0A1222",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/plain",
            ".txt",
            "application/pdf",
            ".pdf",
            "audio/*",
            "video/*",
            ".m4a",
            ".mp3",
            ".aac",
            ".wav",
            ".ogg",
            ".opus",
            ".mp4",
            ".mov",
            ".3gp",
            ".webm",
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Assistant",
      "url": "./?view=assistant"
    },
    {
      "name": "Calendar",
      "url": "./?view=calendar"
    },
    {
      "name": "Studio",
      "url": "./?view=studio"
    }
  ],
  "description": "Your notebook: notes from lessons and meetings, tasks, calendar and an assistant, in Arabic and English."
}
